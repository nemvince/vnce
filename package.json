    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "mdsvex": "^0.12.8",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "phosphor-svelte": "^3.1.0",
    "shiki": "^4.4.3",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "packageManager": "bun@1.4.2"
